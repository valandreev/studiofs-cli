#!/usr/bin/python3
"""xfstests-only mount helper; configuration comes from the caller environment."""
import argparse
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time


def mount_command(source, target, options, env):
    test, scratch = env["TEST_DEV"], env["SCRATCH_DEV"]
    if test == scratch or not all(re.fullmatch(r"[a-zA-Z0-9_-]+", v) for v in (test, scratch)):
        raise ValueError("TEST_DEV and SCRATCH_DEV must be distinct volume names")
    targets = {test: env["TEST_DIR"], scratch: env["SCRATCH_MNT"]}
    if source not in targets or target != targets[source]:
        raise ValueError("source and target must match the isolated harness config")
    if not Path(target).is_absolute() or any(c.isspace() for c in target):
        raise ValueError("mountpoint must be absolute without whitespace")
    if Path(target).name != source:
        raise ValueError("StudioFS mountpoint basename must equal its volume name")
    opts = set(filter(None, options.split(",")))
    if opts - {"rw", "ro", "defaults", "relatime", "allow_other", "default_permissions"}:
        raise ValueError("unsupported mount options; see harness README")
    command = [env["STUDIOFS_BINARY"], "mount", source, target, "--foreground",
               "--allow-other=true"]
    if "ro" in opts:
        command.append("--read-only")
    return command


def attached(source, target, table=Path("/proc/self/mounts")):
    return any(row.split()[:3] == [source, target, "fuse.studiofs"]
               for row in table.read_text().splitlines())


def wait_previous(pidfile, command):
    if not pidfile.exists():
        return
    pid = int(pidfile.read_text().strip())
    deadline = time.monotonic() + 120
    while True:
        try:
            old = Path(f"/proc/{pid}/cmdline").read_bytes().decode().split("\0")
        except FileNotFoundError:
            return
        if old[:4] != command[:4]:
            return
        if time.monotonic() >= deadline:
            raise ValueError("previous task daemon did not finish unmounting")
        time.sleep(0.1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source")
    parser.add_argument("target")
    parser.add_argument("-o", default="rw")
    parser.add_argument("-n", action="store_true")
    parser.add_argument("-v", action="store_true")
    args = parser.parse_args()
    command = mount_command(args.source, args.target, args.o, os.environ)
    client = Path(os.environ["STUDIOFS_CLIENT_ROOT"])
    artifacts = Path(os.environ["XFSTESTS_RUN"]) / "mounts"
    if not client.is_absolute() or not artifacts.is_absolute():
        raise ValueError("client and artifact directories must be absolute")
    if any(row.split()[1] == args.target for row in Path("/proc/self/mounts").read_text().splitlines()):
        raise ValueError("mountpoint is already occupied")
    Path(args.target).mkdir(parents=True, exist_ok=True)
    artifacts.mkdir(parents=True, exist_ok=True)
    pidfile = artifacts / (args.source + ".pid")
    # umount detaches FUSE before StudioFS has released its client lock.
    wait_previous(pidfile, command)
    log = artifacts / (args.source + ".log")
    # util-linux strips PATH before invoking a mount helper.
    daemon_env = dict(os.environ, PATH="/usr/sbin:/usr/bin:/sbin:/bin")
    with log.open("ab", buffering=0) as output:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=output,
                                   stderr=output, start_new_session=True, env=daemon_env)
    # Probe in a bounded child: a stale FUSE syscall must not trap the helper.
    if "--read-only" in command:
        probe = "import os,sys; os.stat(sys.argv[1])"
    else:
        probe = ("import os,sys,tempfile; fd,p=tempfile.mkstemp(prefix='.xfstests-ready-',"
                 "dir=sys.argv[1]); os.fchmod(fd,0o666); os.close(fd); os.unlink(p)")
    ready = False
    try:
        pidfile.write_text(str(process.pid) + "\n")
        deadline = time.monotonic() + 120
        while process.poll() is None and time.monotonic() < deadline:
            if attached(args.source, args.target):
                try:
                    result = subprocess.run([sys.executable or "/usr/bin/python3", "-c", probe, args.target],
                                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                            timeout=2, check=False, env=daemon_env)
                    if result.returncode == 0:
                        ready = True
                        return 0
                except subprocess.TimeoutExpired:
                    pass
            time.sleep(0.1)
    finally:
        if not ready and attached(args.source, args.target):
            detached = subprocess.run(["/usr/bin/timeout", "-k", "2", "10", "/usr/bin/fusermount3", "-uz", args.target],
                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            if detached.returncode != 0:
                subprocess.run(["/usr/bin/timeout", "-k", "2", "10", "/usr/bin/umount", "-l", args.target],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if not ready and process.poll() is None:
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(process.pid, sig)
                except ProcessLookupError:
                    pass
                try:
                    process.wait(timeout=10)
                    break
                except subprocess.TimeoutExpired:
                    continue
    print(f"StudioFS mount did not become ready; inspect {log}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyError, ValueError, OSError):
        # Do not render exceptions that could carry environment/config secrets.
        sys.exit("invalid harness configuration or mount launch failure; see README")
