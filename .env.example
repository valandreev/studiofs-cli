# s3 mount endpoint
STUDIOFS_S3_ENDPOINT=http://127.0.0.1:9000
STUDIOFS_S3_ACCESS_KEY=studiofs
STUDIOFS_S3_SECRET_KEY=studiofs123
STUDIOFS_S3_BUCKET=studiofs-test

# Local PostgreSQL DSN for ignored integration tests in studiofs-meta.
# Keep real credentials only in local `.env` (gitignored).
STUDIOFS_TEST_PG_DSN=host=<PG_HOST> port=5432 user=<PG_USER> password=<PG_PASSWORD> dbname=<PG_DB> sslmode=disable

# Optional Pyroscope profiling config for `studiofs test-cache --profile=pyroscope`.
# STUDIOFS_PYROSCOPE_URL=http://localhost:4040
# STUDIOFS_PYROSCOPE_APP_NAME=studiofs.test-cache
# STUDIOFS_PYROSCOPE_SAMPLE_RATE=100
# STUDIOFS_PYROSCOPE_USERNAME=
# STUDIOFS_PYROSCOPE_PASSWORD=
# STUDIOFS_PYROSCOPE_TENANT_ID=

# grepai api keys
OPENAI_API_KEY=your-openai-api-key
# QDRANT_API_KEY=your-qdrant-api-key
