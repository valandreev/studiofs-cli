# s3 mount endpoint
STUDIOFS_S3_ENDPOINT=http://127.0.0.1:9000
STUDIOFS_S3_ACCESS_KEY=studiofs
STUDIOFS_S3_SECRET_KEY=studiofs123
STUDIOFS_S3_BUCKET=studiofs-test

# Local PostgreSQL DSN for ignored integration tests in studiofs-meta.
# Keep real credentials only in local `.env` (gitignored).
STUDIOFS_TEST_PG_DSN=host=<PG_HOST> port=5432 user=<PG_USER> password=<PG_PASSWORD> dbname=<PG_DB> sslmode=disable

# macOS mounted E2E only: base directory for real client mount points.
# Each client gets an isolated child directory below this root.
# Keep runner artifacts and metadata under the E2E sandbox.
# STUDIOFS_E2E_MOUNT_ROOT=/Volumes/studiofs
