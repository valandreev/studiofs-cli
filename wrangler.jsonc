// Cloudflare Worker that serves the static website from site/ (landing page
// plus the user guide built into site/docs/ by docs/user-guide/build-site.sh).
// Deployed by .github/workflows/deploy-site.yml.
{
  "name": "studiofs-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "studiofs.app", "custom_domain": true }
  ],
  "workers_dev": false
}
